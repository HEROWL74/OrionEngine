{
  "version": 6,

  "configurePresets": [
    {
      "name": "x64-debug",
      "displayName": "Windows x64 Debug (VS2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64-debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-release-local",
      "displayName": "Windows x64 Release (VS2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64-release-local",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-release-ci",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-release-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "web-release",
      "displayName": "Web Release (Emscripten)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "editor-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug",
      "targets": [ "OrionEditor", "OrionBuildWorker" ]
    },
    {
      "name": "runtime-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug",
      "targets": [ "OrionGame" ]
    },
    {
      "name": "editor-release-local",
      "configurePreset": "x64-release-local",
      "configuration": "Release",
      "targets": [ "OrionEditor" ]
    },
    {
      "name": "runtime-release-local",
      "configurePreset": "x64-release-local",
      "configuration": "Release",
      "targets": [ "OrionGame" ]
    },
    {
      "name": "editor-release-ci",
      "configurePreset": "x64-release-ci",
      "configuration": "Release",
      "targets": [ "OrionEditor" ]
    },
    {
      "name": "runtime-release-ci",
      "configurePreset": "x64-release-ci",
      "configuration": "Release",
      "targets": [ "OrionGame" ]
    },
    {
      "name": "runtime-web-release",
      "configurePreset": "web-release",
      "targets": [ "OrionGame" ]
    }
  ]
}
