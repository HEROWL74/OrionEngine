      ]
    },
    {
      "name": "editor-release-ci",
      "configurePreset": "x64-release-ci",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "linux-editor-debug",
      "configurePreset": "linux-debug",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "linux-editor-release-local",
      "configurePreset": "linux-release-local",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "linux-editor-release-ci",
      "configurePreset": "linux-release-ci",
      "targets": [
        "OrionEditor"
      ]
    }
  ]
}