{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-win",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER_FRONTEND_VARIANT": "MSVC",
        "CMAKE_CXX_COMPILER_FRONTEND_VARIANT": "MSVC",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0",
        "CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION": "10.0.26100.0",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_STANDARD_INCLUDE_DIRECTORIES": "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um",
        "CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES": "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared;C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um",
        "CMAKE_LIBRARY_PATH": "C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/um/x64"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "Windows x64 Debug (Clang-cl + Ninja)",
      "inherits": "base-win",
      "binaryDir": "${sourceDir}/build/x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-release-local",
      "displayName": "Windows x64 Release (Clang-cl + Ninja)",
      "inherits": "base-win",
      "binaryDir": "${sourceDir}/build/x64-release-local",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-release-ci",
      "displayName": "Windows x64 Release CI",
      "inherits": "base-win",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-release-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    },
    {
      "name": "x64-relwithdebinfo-ci",
      "displayName": "Windows x64 RelWithDebInfo CI",
      "inherits": "base-win",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-relwithdebinfo-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Z7 /DNDEBUG",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/O2 /Z7 /DNDEBUG"
      }
    },
    {
      "name": "base-linux",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_TOOLCHAIN_FILE": "/home/pc_user/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "WSL"
        },
        "jetbrains.com/rider": {
          "toolchain": "WSL"
        }
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release-local",
      "displayName": "Linux Release",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/build/linux-release-local",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-release-ci",
      "displayName": "Linux Release CI",
      "inherits": "base-linux",
      "binaryDir": "${sourceDir}/build/linux-release-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "editor-debug",
      "configurePreset": "x64-debug",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "editor-release-local",
      "configurePreset": "x64-release-local",
