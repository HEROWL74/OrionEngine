{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-debug",
      "displayName": "Windows x64 Debug (VS2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64-debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-release-local",
      "displayName": "Windows x64 Release (VS2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64-release-local",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-release-ci",
      "displayName": "Windows x64 Release CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-release-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    },
    {
      "name": "x64-relwithdebinfo-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Z7 /DNDEBUG",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/O2 /Z7 /DNDEBUG"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (WSL Ubuntu)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "/home/pc_user/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "hostOS": [
            "Linux"
          ]
        }
      }
    },
    {
      "name": "linux-release-local",
      "displayName": "Linux Release (WSL Ubuntu)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release-local",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "/home/pc_user/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "hostOS": [
            "Linux"
          ]
        }
      }
    },
    {
      "name": "linux-release-ci",
      "displayName": "Linux Release CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "/home/pc_user/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "editor-debug",
      "displayName": "Build Editor (Debug)",
      "configurePreset": "x64-debug",
      "configuration": "Debug",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "editor-relwithdebinfo-ci",
      "displayName": "Build Editor (RelWithDebInfo CI) ★デバッグシンボル付きRelease",
      "configurePreset": "x64-relwithdebinfo-ci",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "linux-editor-debug",
      "displayName": "Build Linux (Debug)",
      "configurePreset": "linux-debug",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "linux-editor-release-local",
      "displayName": "Build Linux (Release Local)",
      "configurePreset": "linux-release-local",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "linux-editor-release-ci",
      "displayName": "Build Linux (Release CI)",
      "configurePreset": "linux-release-ci",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "editor-release-local",
      "displayName": "Build Editor (Release Local)",
      "configurePreset": "x64-release-local",
      "configuration": "Release",
      "targets": [
        "OrionEditor"
      ]
    },
    {
      "name": "editor-release-ci",
      "displayName": "Build Editor (Release CI)",
      "configurePreset": "x64-release-ci",
      "targets": [
        "OrionEditor"
      ]
    }
  ]
}