{
  "version": 6,
  "configurePresets": [
    {
      "name": "x64-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "editor-debug",
      "displayName": "Editor Debug",
      "configurePreset": "x64-debug",
      "targets": [
        "OrionEditor",
        "OrionBuildWorker"
      ]
    },
    {
      "name": "editor-release",
      "displayName": "Editor Release",
      "configurePreset": "x64-release",
      "targets": [ "OrionEditor" ]
    },
    {
      "name": "runtime-debug",
      "displayName": "Runtime Debug",
      "configurePreset": "x64-debug",
      "targets": [ "OrionGame" ]
    },
    {
      "name": "runtime-release",
      "displayName": "Runtime Release",
      "configurePreset": "x64-release",
      "targets": [ "OrionGame" ]
    }
  ]
}
